# Public browser-safe configuration
PUBLIC_SPOTIFY_CLIENT_ID=
PUBLIC_SPOTIFY_REDIRECT_URI=
PUBLIC_YOUTUBE_API_KEY=
PUBLIC_APPLE_MUSIC_TOKEN_ENDPOINT=
PUBLIC_APPLE_MUSIC_STOREFRONT=us

# Optional Indian-language music discovery API endpoint.
# The default public endpoint used by the app does not require a private API key.
# Prefer a provider endpoint you control for production deployments.
PUBLIC_INDIAN_MUSIC_API_URL=https://saavn.me/search

# Server-only Apple Music signing inputs.
# Do not expose these credentials in client-side JavaScript. Use them only in a secure
# token service that returns a short-lived Apple Music developer token to
# PUBLIC_APPLE_MUSIC_TOKEN_ENDPOINT.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Never commit real secrets in .env or .env.* files.
